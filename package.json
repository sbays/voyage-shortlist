{
  "name": "voyage-shortlist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node src/db/cli.ts setup && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "db:migrate": "node src/db/cli.ts migrate",
    "db:seed": "node src/db/cli.ts seed",
    "eval": "node src/evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@electric-sql/pglite": "^0.5.16",
    "@google-cloud/storage": "^8.4.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.5.1"
}
